class Solution {
    public boolean halvesAreAlike(String s) {
        int count = 0;
        int n = s.length();

        for (int i = 0; i < n; i++) {
            char ch = s.charAt(i);

            if ("aeiouAEIOU".indexOf(ch) != -1) {
                if (i < n / 2)
                    count++;
                else
                    count--;
            }
        }

        return count == 0;
    }
}
