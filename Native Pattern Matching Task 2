import java.util.*;

class Solution {
    public ArrayList<Integer> search(String pat, String txt) {
        ArrayList<Integer> result = new ArrayList<>();

        int m = pat.length();
        int n = txt.length();

        int[] lps = new int[m];
        int len = 0;

        for (int i = 1; i < m; i++) {
            while (len > 0 && pat.charAt(i) != pat.charAt(len)) {
                len = lps[len - 1];
            }

            if (pat.charAt(i) == pat.charAt(len)) {
                len++;
            }

            lps[i] = len;
        }

        int i = 0;
        int j = 0;

        while (i < n) {
            if (txt.charAt(i) == pat.charAt(j)) {
                i++;
                j++;
            }

            if (j == m) {
                result.add(i - j);
                j = lps[j - 1];
            } else if (i < n && txt.charAt(i) != pat.charAt(j)) {
                if (j > 0) {
                    j = lps[j - 1];
                } else {
                    i++;
                }
            }
        }

        return result;
    }
}
