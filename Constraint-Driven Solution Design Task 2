import java.util.*;

class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int T = sc.nextInt();
        
        while (T-- > 0) {
            String s = sc.next();
            int n = s.length();
            int[] freq = new int[26];
            
            for (int i = 0; i < n / 2; i++) {
                freq[s.charAt(i) - 'a']++;
            }
            
            for (int i = (n + 1) / 2; i < n; i++) {
                freq[s.charAt(i) - 'a']--;
            }
            
            boolean flag = true;
            
            for (int f : freq) {
                if (f != 0) {
                    flag = false;
                    break;
                }
            }
            
            System.out.println(flag ? "YES" : "NO");
        }
        
        sc.close();
    }
}
